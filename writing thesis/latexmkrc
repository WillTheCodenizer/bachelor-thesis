#!/usr/bin/env perl
# LuaLaTeX + Biber configuration for latexmk

# All generated files go here. latexmk puts $out_dir on TEXINPUTS itself, so
# lualatex finds the thesis.bbl that biber wrote in the previous pass.
$out_dir = 'build';

# LuaLaTeX is the engine (the class needs fontspec/unicode-math).
# $pdf_mode = 4 selects $lualatex. Do not use $pdf_mode = 1 with a hacked
# $pdflatex: a caller passing -pdf would then silently use a different setup.
$pdf_mode = 4;
$lualatex = 'lualatex -file-line-error -interaction=nonstopmode -synctex=1 %O %S';

# -halt-on-error is deliberately NOT used: it aborts the first pass (which
# always has undefined citations because no .bbl exists yet) before biber runs.

# Configure biber for bibliography
$bibtex_use = 2;       # 2 = biber
$biber = 'biber %O %B';

# Extra files for `latexmk -c/-C`; aux, bcf, fls, fdb_latexmk are built in.
$clean_ext = 'bbl run.xml synctex.gz';

# Process default file
@default_files = ('thesis.tex');
