\@writefile{lot}{\contentsline {table}{\numberline {3.2}{\ignorespaces FRB survey configurations adopted in this thesis, following~\blx@tocontentsinit {0}\cite {Reischke_2021}. The steepness parameter $\mitalpha $ enters the redshift distribution of \autoref {eq:frb_nz}, while the total number of bursts $N_{\mathrm {tot}}$ and the sky fraction $f_{\mathrm {sky}}$ determine the shot-noise level according to \autoref {eq:shot_noise}.}}{16}{table.caption.7}\protected@file@percent }
\newlabel{tab:frb_surveys}{{3.2}{16}{FRB survey configurations adopted in this thesis, following~\cite {Reischke_2021}. The steepness parameter $\alpha $ enters the redshift distribution of \autoref {eq:frb_nz}, while the total number of bursts $N_{\mathrm {tot}}$ and the sky fraction $f_{\mathrm {sky}}$ determine the shot-noise level according to \autoref {eq:shot_noise}}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Normalised FRB redshift distributions of \autoref {eq:frb_nz} for the shallow ($\mitalpha =3.5$) and deep ($\mitalpha =2.0$) survey configuration. The shallow configuration peaks near $z\approx 0.6$ and falls off rapidly beyond $z\approx 1.5$, whereas the deep configuration peaks near $z\approx 1.0$ and retains appreciable support out to $z\approx 3$. The deep configuration therefore overlaps substantially more with the high-redshift galaxy bins, which is the decisive factor for the cross-correlation signal discussed in \autoref {sec:cross_correlation_analysis}.}}{16}{figure.caption.8}\protected@file@percent }
\newlabel{fig:frb_nz}{{3.2}{16}{Normalised FRB redshift distributions of \autoref {eq:frb_nz} for the shallow ($\alpha =3.5$) and deep ($\alpha =2.0$) survey configuration. The shallow configuration peaks near $z\approx 0.6$ and falls off rapidly beyond $z\approx 1.5$, whereas the deep configuration peaks near $z\approx 1.0$ and retains appreciable support out to $z\approx 3$. The deep configuration therefore overlaps substantially more with the high-redshift galaxy bins, which is the decisive factor for the cross-correlation signal discussed in \autoref {sec:cross_correlation_analysis}}{figure.caption.8}{}}
