\@writefile{toc}{\contentsline {subsection}{\numberline {3.6.1}Auto-Correlation Analysis}{21}{subsection.3.6.1}\protected@file@percent }
\newlabel{sec:auto_correlation_analysis}{{3.6.1}{21}{Auto-Correlation Analysis}{subsection.3.6.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces FRB auto-correlation angular power spectrum for the magnetar population in the shallow survey configuration, shown with and without the Poissonian shot-noise contribution. The clustering signal peaks at $\ell \approx 20$ and falls off steeply thereafter, whereas the shot noise is scale-independent and exceeds the signal by roughly three orders of magnitude across the entire multipole range. For a burst sample of only $\num {5e3}$ events the FRB auto-correlation is therefore completely noise-dominated, which is the central motivation for combining it with a dense galaxy sample in a cross-correlation analysis.}}{21}{figure.caption.12}\protected@file@percent }
\newlabel{fig:frb_cell_shotnoise}{{3.4}{21}{FRB auto-correlation angular power spectrum for the magnetar population in the shallow survey configuration, shown with and without the Poissonian shot-noise contribution. The clustering signal peaks at $\ell \approx 20$ and falls off steeply thereafter, whereas the shot noise is scale-independent and exceeds the signal by roughly three orders of magnitude across the entire multipole range. For a burst sample of only $\num {5e3}$ events the FRB auto-correlation is therefore completely noise-dominated, which is the central motivation for combining it with a dense galaxy sample in a cross-correlation analysis}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Signal-only FRB auto-correlation angular power spectra for the shallow and deep survey configuration, shown for the magnetar population (top) and the delayed neutron-star population (bottom). In both cases the shallow configuration yields the larger amplitude, since its narrower redshift distribution projects a smaller radial range onto the same angular scale and therefore suffers less from line-of-sight dilution. Comparing the two panels shows that the choice of progenitor model changes the overall amplitude but leaves the shape of the spectrum largely unaffected, which illustrates the degeneracy between bias amplitude and redshift evolution in the auto-spectrum alone. HIER NOCHMAL SCHAUEN OB WIRKLICH DAS GANZE SO RICHTIG ERKLAERT IST}}{22}{figure.caption.13}\protected@file@percent }
\newlabel{fig:frb_cell_comparison}{{3.5}{22}{Signal-only FRB auto-correlation angular power spectra for the shallow and deep survey configuration, shown for the magnetar population (top) and the delayed neutron-star population (bottom). In both cases the shallow configuration yields the larger amplitude, since its narrower redshift distribution projects a smaller radial range onto the same angular scale and therefore suffers less from line-of-sight dilution. Comparing the two panels shows that the choice of progenitor model changes the overall amplitude but leaves the shape of the spectrum largely unaffected, which illustrates the degeneracy between bias amplitude and redshift evolution in the auto-spectrum alone. HIER NOCHMAL SCHAUEN OB WIRKLICH DAS GANZE SO RICHTIG ERKLAERT IST}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Signal-only galaxy auto-correlation angular power spectra of the six KiDS-Legacy tomographic bins. The amplitude decreases systematically from the low-redshift to the high-redshift bins: although the bias increases with redshift according to \autoref {eq:galaxy_bias}, this is more than compensated by the broader radial extent of the high-redshift bins and by the smaller amplitude of the matter power spectrum at earlier times. In addition, the peak of the spectrum shifts towards higher multipoles for the higher bins, since a fixed comoving scale subtends a smaller angle when viewed from a larger distance. HIER AUCH NOCHMAL REINGUCKEN UND VERSTEHEN FALLS NOETIG}}{23}{figure.caption.14}\protected@file@percent }
\newlabel{fig:galaxy_cell_comparison}{{3.6}{23}{Signal-only galaxy auto-correlation angular power spectra of the six KiDS-Legacy tomographic bins. The amplitude decreases systematically from the low-redshift to the high-redshift bins: although the bias increases with redshift according to \autoref {eq:galaxy_bias}, this is more than compensated by the broader radial extent of the high-redshift bins and by the smaller amplitude of the matter power spectrum at earlier times. In addition, the peak of the spectrum shifts towards higher multipoles for the higher bins, since a fixed comoving scale subtends a smaller angle when viewed from a larger distance. HIER AUCH NOCHMAL REINGUCKEN UND VERSTEHEN FALLS NOETIG}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6.2}Cross-Correlation Analysis}{24}{subsection.3.6.2}\protected@file@percent }
\newlabel{sec:cross_correlation_analysis}{{3.6.2}{24}{Cross-Correlation Analysis}{subsection.3.6.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces FRB$\times $galaxy angular cross-power spectra for the magnetar population in the deep survey configuration, shown separately for the six tomographic galaxy bins. The amplitude decreases monotonically from the first to the sixth bin, directly reflecting the decreasing radial overlap between the FRB redshift distribution of \autoref {fig:frb_nz} and the progressively higher-redshift galaxy bins of \autoref {fig:galaxy_nz}. The cross-spectrum therefore acts as a tomographic probe of the FRB redshift distribution.}}{24}{figure.caption.15}\protected@file@percent }
\newlabel{fig:cross_bin_comparison}{{3.7}{24}{FRB$\times $galaxy angular cross-power spectra for the magnetar population in the deep survey configuration, shown separately for the six tomographic galaxy bins. The amplitude decreases monotonically from the first to the sixth bin, directly reflecting the decreasing radial overlap between the FRB redshift distribution of \autoref {fig:frb_nz} and the progressively higher-redshift galaxy bins of \autoref {fig:galaxy_nz}. The cross-spectrum therefore acts as a tomographic probe of the FRB redshift distribution}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Comparison of the FRB$\times $galaxy cross-power spectra of the magnetar and the delayed neutron-star population in the deep survey configuration, shown for all six tomographic galaxy bins. In the sixth bin, whose mean redshift lies above the crossing point of the two bias models, the two predictions become nearly indistinguishable. The separation between the progenitor classes is thus bin-dependent, which is what makes a tomographic cross-correlation analysis informative.}}{25}{figure.caption.16}\protected@file@percent }
\newlabel{fig:cross_population}{{3.8}{25}{Comparison of the FRB$\times $galaxy cross-power spectra of the magnetar and the delayed neutron-star population in the deep survey configuration, shown for all six tomographic galaxy bins. In the sixth bin, whose mean redshift lies above the crossing point of the two bias models, the two predictions become nearly indistinguishable. The separation between the progenitor classes is thus bin-dependent, which is what makes a tomographic cross-correlation analysis informative}{figure.caption.16}{}}
